local DEFAULT_HIGHLIGHT_COLOR = Color3.fromRGB(255, 255, 255)  -- สีม่วงสำหรับไม่ตรงรายการ
local DEFAULT_TEXT_COLOR = Color3.fromRGB(255, 255, 255)  

-- โฟลเดอร์ของตก
local droppedFolder = Workspace:FindFirstChild("DroppedItem") or Workspace:FindFirstChild("DroppedItems")      
if not droppedFolder then      
    warn("ไม่พบโฟลเดอร์ DroppedItem / DroppedItems")      
    return      
end      

-- ฟังก์ชันเลือกสีตามชื่อ
local function getItemColor(itemName)
    for key, color in pairs(ITEM_COLORS) do
        if string.find(itemName, key) then
            return color
        end
    end
    return DEFAULT_HIGHLIGHT_COLOR
end

-- ฟังก์ชันสร้าง ESP ให้ไอเทม 1 ชิ้น      
local function createItemESP(item)      
    if not ItemESP_Enabled then return end      
    if ESP_Items[item] then return end      
    if item.Name == "Money" then return end      
    if not item:FindFirstChild("Handle") and not item.PrimaryPart then return end      

    local handle = item:FindFirstChild("Handle") or item.PrimaryPart      
    local color = getItemColor(item.Name)
      
    -- Highlight      
    local highlight = Instance.new("Highlight")      
    highlight.FillColor = color      
    highlight.OutlineColor = color      
    highlight.FillTransparency = 0.3      
    highlight.OutlineTransparency = 0      
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop      
    highlight.Parent = item      
      
    -- ชื่อไอเทม      
    local nameText = Drawing.new("Text")      
    nameText.Size = 7      
    nameText.Color = color      
    nameText.Center = true      
    nameText.Outline = true      
    nameText.Font = 2      
    nameText.Visible = true      
    nameText.Text = item.Name      
      
    -- ระยะทาง      
    local distanceText = Drawing.new("Text")      
    distanceText.Size = 7      
    distanceText.Color = DEFAULT_TEXT_COLOR      
    distanceText.Center = true      
    distanceText.Outline = true      
    distanceText.Font = 2      
    distanceText.Visible = true      
      
    ESP_Items[item] = {highlight = highlight, name = nameText, distance = distanceText, handle = handle, color=color}      
      
    -- ลบเมื่อไอเทมหาย      
    item.AncestryChanged:Connect(function()      
        if not item.Parent then      
            if ESP_Items[item] then      
                highlight:Destroy()      
                nameText:Remove()      
                distanceText:Remove()      
                ESP_Items[item] = nil      
            end      
        end      
    end)      
end      

-- เปิด ESP
local function enableItemESP()      
    ItemESP_Enabled = true      
    for _, item in pairs(droppedFolder:GetChildren()) do      
        if item:IsA("Model") or item:IsA("Tool") or item:IsA("Folder") then      
            task.spawn(function()      
                task.wait(0.3)      
                createItemESP(item)      
            end)      
        end      
    end      
end      

-- ปิด ESP
local function disableItemESP()      
    ItemESP_Enabled = false      
    for item, data in pairs(ESP_Items) do      
        if data.highlight then data.highlight:Destroy() end      
        if data.name then data.name:Remove() end      
        if data.distance then data.distance:Remove() end      
    end      
    ESP_Items = {}      
end      

-- อัปเดตตำแหน่งชื่อ + ระยะทางทุกเฟรม      
RunService.Heartbeat:Connect(function()      
    if not ItemESP_Enabled then return end      
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end      
    local rootPos = player.Character.HumanoidRootPart.Position      
      
    for item, data in pairs(ESP_Items) do      
        if item and item.Parent and data.handle and data.handle.Parent then      
            local worldPos = data.handle.Position + Vector3.new(0, 2, 0)      
            local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)      
      
            if onScreen then      
                local screen2D = Vector2.new(screenPos.X, screenPos.Y)      
                local distance = math.floor((rootPos - data.handle.Position).Magnitude)      
      
                data.name.Position = screen2D      
                data.name.Color = data.color  -- อัพเดตสีตามชื่อ      
                data.name.Visible = true      
      
                data.distance.Position = screen2D + Vector2.new(0, 18)      
                data.distance.Text = distance .. "m"      
                data.distance.Color = DEFAULT_TEXT_COLOR      
                data.distance.Visible = true      
            else      
                data.name.Visible = false      
                data.distance.Visible = false      
            end      
        else      
            -- ลบถ้าไอเทมหาย      
            if data.highlight then data.highlight:Destroy() end      
            if data.name then data.name:Remove() end      
            if data.distance then data.distance:Remove() end      
            ESP_Items[item] = nil      
        end      
    end      
end)      

-- เมื่อมีของตกใหม่      
droppedFolder.ChildAdded:Connect(function(item)      
    task.wait(0.5)      
    createItemESP(item)      
end)      

