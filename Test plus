local RunService = game:GetService("RunService")
local Vehicle_upvr = require(game.ReplicatedStorage.Modules.Game.VehicleSystem.Vehicle)
local UI_upvr = require(game.ReplicatedStorage.Modules.Core.UI)
local Net_upvr = require(game.ReplicatedStorage.Modules.Core.Net)

-- ตัวแปรเปิด/ปิด Auto Lock
local AutoLockEnabled = false

-- ฟังก์ชัน Auto Lock Vehicle
local function AutoLockLoop()
    RunService.Heartbeat:Connect(function()
        if not AutoLockEnabled then return end

        local vehicle = Vehicle_upvr.current_driving.get()
        if vehicle then
            local vehicleClass = Vehicle_upvr.class.get(vehicle)
            local lockedState = vehicleClass.states.locked.get()
            local lockButtonUI = UI_upvr.get("LockVehicleButton")

            -- ถ้ายังไม่ล็อค → ล็อคและเปลี่ยนไอคอน
            if not lockedState then
                if lockButtonUI then
                    lockButtonUI.Image = "rbxassetid://6249640130" -- ไอคอนล็อค
                end
                Net_upvr.send("lock_vehicle", vehicle, true)
                vehicleClass.states.locked.set(true)
            else
                -- ถ้าล็อคแล้ว → เปลี่ยนไอคอน
                if lockButtonUI then
                    lockButtonUI.Image = "rbxassetid://6249640130"
                end
            end
        end
    end)
end

-- เรียก Loop
AutoLockLoop()

-- 🌟 UI Toggle
EspTab:Toggle({
    Title = "Auto Lock Vehicle",
    Value = AutoLockEnabled,
    Callback = function(state)
        AutoLockEnabled = state
    end
})

-- 🌟 Bypass Kick
pcall(function()
    for _, v in pairs(getgc(true)) do
        if typeof(v) == "function" and getfenv(v).script == game:GetService("Players").LocalPlayer.PlayerScripts then
            local kickF = v
            hookfunction(kickF, function(p12, p13, p14, p15, ...)
                return p12(p13, p14, p15, ...)
            end)
        end
    end
end)
