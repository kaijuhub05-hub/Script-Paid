-- ตัวแปรเปิดปิด Auto Lock
local AutoLockEnabled = false

-- ไอคอนล็อครถ
local LOCK_ICON = "rbxassetid://6249640130"      -- ล็อค
local UNLOCK_ICON = "rbxassetid://14061898347"  -- ปลดล็อค

-- ฟังก์ชันตรวจสอบและล็อครถอัตโนมัติ
local function AutoLockVehicle()
    if not AutoLockEnabled then return end

    local vehicle = Vehicle_upvr.current_driving.get()
    local lockButton = UI_upvr.get("LockVehicleButton")
    
    if vehicle then
        local vehicleState = Vehicle_upvr.class.get(vehicle).states
        -- ถ้ายานพาหนะยังไม่ล็อค ให้ล็อคทันที
        if not vehicleState.locked.get() then
            Net_upvr.send("lock_vehicle", vehicle, true)
            module_upvr.enabled.set(true)
        end
        -- เปลี่ยนไอคอนปุ่มล็อครถให้เป็นล็อค
        if lockButton then
            lockButton.Image = LOCK_ICON
            lockButton.Visible = true
        end
    else
        -- ถ้าไม่ได้ขึ้นยานพาหนะ ให้ปุ่มล็อคยังคงอยู่
        if lockButton then
            lockButton.Image = LOCK_ICON
            lockButton.Visible = true
        end
        module_upvr.enabled.set(false)
    end
end

-- เรียกทุกเฟรม
game:GetService("RunService").Heartbeat:Connect(function()
    pcall(AutoLockVehicle)
end)

-- 🌟 ฟังก์ชัน Toggle สำหรับ UI
function ToggleAutoLockVehicle(state)
    AutoLockEnabled = state
end

-- ตัวอย่างการสร้างปุ่มเปิดปิดใน UI
-- สมมติว่า EspTab คือ Tab ของคุณ
EspTab:Toggle({
    Title = "Auto Lock Vehicle",
    Value = false,
    Callback = function(state)
        ToggleAutoLockVehicle(state)
    end
})
