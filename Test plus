-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Local Player
local LocalPlayer = Players.LocalPlayer

-- Net Module (ถ้ามี)
local Net
pcall(function()
    Net = require(ReplicatedStorage.Modules.Core.Net)
end)

-- Function: Invisible & Respawn
local function invisibleRespawn()
    task.spawn(function()
        pcall(function()
            setfflag("NextGenReplicatorEnabledWrite4", "false")
            wait(0.1)
            if Net then
                Net.send("request_respawn")
            end
            wait(5)
            setfflag("NextGenReplicatorEnabledWrite4", "true")
        end)
    end)
end

-- Button
CheaterTab:Button({
    Title = "Invisible & Respawn",
    Desc = "Press to become invisible and respawn immediately.",
    Callback = invisibleRespawn
})

-- Kick Bypass
task.defer(function()
    pcall(function()
        for _, conn in ipairs(getconnections(LocalPlayer.OnKick)) do
            if conn.Function then
                hookfunction(conn.Function, function(p12, p13, p14, p15, ...)
                    return p12(p13, p14, p15, ...)
                end)
            end
        end
    end)
end)
