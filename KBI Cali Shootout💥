-- ===== MOVE =====
local function flyStep(targetPos, dt)
    local dir = targetPos - hrp.Position
    local dist = dir.Magnitude
    if dist <= REACH_DISTANCE then
        return true
    end
    hrp.CFrame = hrp.CFrame + dir.Unit * SPEED * dt
    return false
end

-- ===== TOOL SYSTEM =====
local function GetValidTool()
    if not character then return nil end
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Tool") and v.Name ~= "Phone" then
            return v
        end
    end
    return nil
end

local function EquipAnyTool()
    if not character then return end
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    for _, v in ipairs(backpack:GetChildren()) do
        if v:IsA("Tool") and v.Name ~= "Phone" then
            v.Parent = character
            return
        end
    end
end

local function HasGarbageTool()
    return character and character:FindFirstChild("Garbage") ~= nil
end

local function EquipGarbageTool()
    if HasGarbageTool() then return end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild("Garbage")
        if tool then
            tool.Parent = character
        end
    end
end

player.Backpack.ChildAdded:Connect(function(tool)
    if tool:IsA("Tool") and tool.Name ~= "Phone" then
        tool.Parent = character
    end
end)

