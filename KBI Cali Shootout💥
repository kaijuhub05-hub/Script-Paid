getgenv().AutoResetStuck = false

local lastPos = nil
local stuckTime = 0
local STUCK_SPEED = 10
local STUCK_DELAY = 1.2

RunService.Heartbeat:Connect(function(dt)
    if not getgenv().AutoResetStuck then return end
    if not hrp or not hrp.Parent then return end

    if not lastPos then
        lastPos = hrp.Position
        stuckTime = 0
        return
    end

    local speed = (hrp.Position - lastPos).Magnitude / math.max(dt, 0.016)
    lastPos = hrp.Position

    if speed < STUCK_SPEED then
        stuckTime += dt
        if stuckTime >= STUCK_DELAY then
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 4, 0)
            stuckTime = 0
        end
    else
        stuckTime = 0
    end
end)

characterTab:Toggle({
    Title = "Anti Stuck",
    Value = false,
    Callback = function(v)
        getgenv().AutoResetStuck = v
        lastPos = nil
        stuckTime = 0
    end
})

