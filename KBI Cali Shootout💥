-- ===== PATH BLOCK =====
local PathBlock

local function RemovePathBlock()
    if PathBlock then
        PathBlock:Destroy()
        PathBlock = nil
    end
end

local function CreatePathBlock()
    if PathBlock then return end
    PathBlock = Instance.new("Part")
    PathBlock.Name = "Kaiju_PathBlock"
    PathBlock.Anchored = true
    PathBlock.CanCollide = false
    PathBlock.Material = Enum.Material.Neon
    PathBlock.Color = Color3.fromRGB(170, 0, 255)
    PathBlock.Transparency = 0.15
    PathBlock.Parent = workspace
end

-- ===== MAIN LOOP =====
RunService.Heartbeat:Connect(function(dt)
    if not getgenv().AutoFarmGarbageJob then
        RemovePathBlock()
        return
    end
    if not hrp or not hrp.Parent then return end

    local jobSystem = workspace:FindFirstChild("Job System")
    if not jobSystem then return end

    local currentJob = jobSystem:FindFirstChild(SELECTED_JOB)
    if not currentJob then return end

    local BOX1 = currentJob:FindFirstChild("BOX1")
    local JOB = currentJob:FindFirstChild("Job")

    -- ===== UPDATE PATH BLOCK =====
    if getgenv().ShowPathBlock and BOX1 then
        local boxPart = BOX1:IsA("Model")
            and (BOX1.PrimaryPart or BOX1:FindFirstChildWhichIsA("BasePart"))
            or BOX1

        if boxPart then
            CreatePathBlock()
            local startPos = hrp.Position - Vector3.new(0, hrp.Size.Y / 2 + 0.2, 0)
            local endPos = boxPart.Position
            local dir = endPos - startPos
            local dist = dir.Magnitude

            PathBlock.Size = Vector3.new(1.2, 0.2, dist)
            PathBlock.CFrame = CFrame.new(startPos + dir / 2, endPos)
        end
    else
        RemovePathBlock()
    end

    if not JOB then return end

    -- ========= BoxPickingJob =========
    if SELECTED_JOB == "BoxPickingJob" then
        local tool = GetValidTool()
        state = tool and "GO_JOB" or "GET_GARBAGE"

        if state == "GET_GARBAGE" and BOX1 then
            local boxPart = BOX1:IsA("Model")
                and (BOX1.PrimaryPart or BOX1:FindFirstChildWhichIsA("BasePart"))
                or BOX1

            if boxPart and flyStep(boxPart.Position, dt) then
                firePrompt(BOX1)
                EquipAnyTool()
            end
            return
        end

        if state == "GO_JOB" then
            local jobPart = JOB:IsA("Model")
                and (JOB.PrimaryPart or JOB:FindFirstChildWhichIsA("BasePart"))
                or JOB

            orbitAngle += ORBIT_SPEED * dt
            local offset = Vector3.new(
                math.cos(orbitAngle) * ORBIT_RADIUS,
                ORBIT_HEIGHT,
                math.sin(orbitAngle) * ORBIT_RADIUS
            )
            hrp.CFrame = CFrame.new(jobPart.Position + offset, jobPart.Position)
        end
        return
    end

    -- ========= GarbageJob =========
    state = HasGarbageTool() and "GO_JOB" or "GET_GARBAGE"

    if state == "GET_GARBAGE" and BOX1 then
        local boxPart = BOX1:IsA("Model")
            and (BOX1.PrimaryPart or BOX1:FindFirstChildWhichIsA("BasePart"))
            or BOX1

        if boxPart and flyStep(boxPart.Position, dt) then
            firePrompt(BOX1)
            EquipGarbageTool()
        end
        return
    end

    if state == "GO_JOB" then
        local jobPart = JOB:IsA("Model")
            and (JOB.PrimaryPart or JOB:FindFirstChildWhichIsA("BasePart"))
            or JOB

        orbitAngle += ORBIT_SPEED * dt
        local offset = Vector3.new(
            math.cos(orbitAngle) * ORBIT_RADIUS,
            ORBIT_HEIGHT,
            math.sin(orbitAngle) * ORBIT_RADIUS
        )
        hrp.CFrame = CFrame.new(jobPart.Position + offset, jobPart.Position)
    end
end)

